{
  "uid": "todo-app",
  "title": "ToDo App",
  "tags": [
    "todo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances up",
      "description": "App copies Prometheus can scrape. Should equal the job's count.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"todo\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second by route. The flat ~0.2 req/s on /{$} is the load balancer's health check.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests per Traefik",
      "description": "Requests per second each Traefik receives on :8000, from the load balancer. The instance shows :8081 because that is where Prometheus reads Traefik's metrics. With both Traefiks healthy the load balancer splits traffic between them; one line at zero means that Traefik is down or out of the load balancer.",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(traefik_entrypoint_requests_total{job=\"traefik\", entrypoint=\"web\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Requests per copy",
      "description": "Requests per second each app copy serves. Every Traefik round-robins across all copies, so the lines should sit close together. One copy far above or below the rest means traffic is not spread evenly.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory per copy",
      "description": "Resident memory of each app copy. The red line is the 128 MiB limit (memory in app.nomad.hcl): a copy that crosses it is OOM killed and restarted. Normal is ~55-70 MiB; it grows when requests pile up inside a copy.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 134217728
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"todo\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Hits / all lookups (hit, miss, error), per operation. ~91% at idle: the 1-minute TTL expires once per 12 health-check lookups.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(cache_requests_total{job=\"todo\", result=\"hit\"}[5m]))\n/\nsum by (op) (rate(cache_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "95% of requests finish faster than this. Estimated from histogram buckets, so values sit just under a bucket edge (5ms, 10ms, ...).",
      "gridPos": {
        "x": 4,
        "y": 17,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,\n  sum by (le) (rate(http_request_duration_seconds_bucket{job=\"todo\"}[5m]))\n)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "description": "Share of responses that are server errors. 'or vector(0)' shows 0% when no 5xx has ever happened.",
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "axisSoftMin": 0,
            "axisSoftMax": 0.1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(\n  sum(rate(http_requests_total{job=\"todo\", status=~\"5..\"}[5m]))\n  or vector(0)\n)\n/\nsum(rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "Each status code's share of all responses, stacked to 100%.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "stacking": {
              "mode": "percent",
              "group": "A"
            },
            "fillOpacity": 50
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Worker",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker events",
      "description": "Events handled per second. 'ok' did work; 'skipped' had nothing to do (delete, task gone, unknown type).",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, outcome) (rate(worker_events_total{job=\"worker-metrics\"}[5m]))",
          "legendFormat": "{{type}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker errors",
      "description": "Failed handle attempts (each retry counts) and Kafka errors. Handle errors with no events means the worker is stuck retrying one event.",
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisSoftMin": 0,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(worker_handle_errors_total{job=\"worker-metrics\"}[5m]))",
          "legendFormat": "handle {{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (op) (rate(worker_kafka_errors_total{job=\"worker-metrics\"}[5m]))",
          "legendFormat": "kafka {{op}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Worker handle time p95",
      "description": "95% of handle attempts finish faster than this.",
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,\n  sum by (le) (rate(worker_handle_duration_seconds_bucket{job=\"worker-metrics\"}[5m]))\n)",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
