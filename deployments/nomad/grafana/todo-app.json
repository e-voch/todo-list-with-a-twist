{
  "uid": "todo-app",
  "title": "ToDo App",
  "tags": ["todo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances up",
      "description": "App copies Prometheus can scrape. Should equal the job's count.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"todo\"})" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second by route. The flat ~0.2 req/s on /{$} is the load balancer's health check.",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "description": "Share of responses that are server errors. 'or vector(0)' shows 0% when no 5xx has ever happened.",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "axisSoftMin": 0, "axisSoftMax": 0.1 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(\n  sum(rate(http_requests_total{job=\"todo\", status=~\"5..\"}[5m]))\n  or vector(0)\n)\n/\nsum(rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "95% of requests finish faster than this. Estimated from histogram buckets, so values sit just under a bucket edge (5ms, 10ms, ...).",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,\n  sum by (le) (rate(http_request_duration_seconds_bucket{job=\"todo\"}[5m]))\n)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Hits / all lookups (hit, miss, error), per operation. ~91% at idle: the 1-minute TTL expires once per 12 health-check lookups.",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(cache_requests_total{job=\"todo\", result=\"hit\"}[5m]))\n/\nsum by (op) (rate(cache_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "Each status code's share of all responses, stacked to 100%.",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "stacking": { "mode": "percent", "group": "A" }, "fillOpacity": 50 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"todo\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
